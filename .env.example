# devnet | testnet | mainnet-beta
NEXT_PUBLIC_CLUSTER=mainnet-beta
# Server-only RPC used for every read, simulation, build and transaction send (never shipped to the browser)
RPC_URL=
# Optional: override the program id baked into src/idl/hedge_vault.json
NEXT_PUBLIC_PROGRAM_ID=
# Optional: Jupiter API (defaults to lite-api.jup.ag without a key, api.jup.ag with one)
JUPITER_API_HOST=
JUPITER_API_KEY=
# Optional: Meteora DLMM pool search API (defaults to dlmm.datapi.meteora.ag)
METEORA_DLMM_API_HOST=
# Optional: protocol address lookup table (scripts/protocol-lookup-table.mjs); unset builds larger transactions
PROTOCOL_LOOKUP_TABLE=
# Database URL for the Hedge Keeper
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hedge_keeper
# Manager bot API keys are read from Postgres (created in the admin dashboard).
# SELECT-only role on the key table (server-only).
API_KEYS_DATABASE_URL=
# Role that may only insert/update usage counters (server-only, optional).
API_KEY_USAGE_DATABASE_URL=
# Fallback only for key ids absent from the database; to be removed one release after import.
# JSON array of key records with SHA-256 digests.
MANAGER_API_KEYS=
# Separate server-only HMAC secret, at least 32 bytes.
MANAGER_API_TICKET_SECRET=
